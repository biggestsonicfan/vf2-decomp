 #define VF2_NATIVE_POST_BOOT_RESUMED_HELPER_INSTRUCTIONS UINT64_C(90)
@@ -146,6 +150,8 @@
 #define VF2_NATIVE_SOUND_CONTINUATION_ENTRY UINT32_C(0x00043abc)
