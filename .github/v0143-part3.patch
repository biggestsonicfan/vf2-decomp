 #define VF2_NATIVE_POST_BOOT_COPRO_HELPER_ENTRY UINT32_C(0x0000a3d4)
 #define VF2_NATIVE_POST_BOOT_COPRO_INIT_RETURN UINT32_C(0x00009f74)
