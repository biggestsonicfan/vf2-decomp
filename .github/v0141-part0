+post_boot_copro_read(vf2_model2a *machine, const vf2_i960_cpu *cpu,
+                     uint32_t *value) {
+    const uint32_t address = cpu->registers[27] + cpu->registers[28];
+    if (address != VF2_COPRO_PORT_BASE + UINT32_C(0x4000)) {
